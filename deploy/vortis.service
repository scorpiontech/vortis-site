# /etc/systemd/system/vortis.service
# Serviço systemd para rodar o SSR Node do site Vortis.
#
# Instalação:
#   sudo cp deploy/vortis.service /etc/systemd/system/vortis.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now vortis.service
#   sudo systemctl status vortis.service
#
# Logs:
#   sudo journalctl -u vortis.service -f
[Unit]
Description=Vortis Gestão (TanStack Start SSR)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/vortis/app
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node /var/www/vortis/app/server/index.mjs
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
